{
  "name": "webpilot",
  "version": "0.10.0204",
  "author": "webpilot.ai",
  "displayName": "Webpilot - Copilot for All, Free & Open",
  "description": "__MSG_extensionDescription__",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "prepare": "husky install",
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "lint": "pnpm lint:eslint && pnpm lint:stylelint && pnpm lint:prettier",
    "lint:eslint": "eslint './**/*.{vue,ts,tsx,js}' --cache --fix",
    "lint:stylelint": "stylelint './{src,assets}/**/*.{vue,scss,css}' --cache --fix",
    "lint:prettier": "prettier './*.{json,md}' './{src,assets}/**/*.{json,md}' --cache --write",
    "gettext": "pnpm gettext:extract && pnpm gettext:compile && pnpm post-gettext",
    "gettext:extract": "vue-gettext-extract",
    "gettext:compile": "vue-gettext-compile",
    "post-gettext": "node ./scripts/i18n/postGettext.js"
  },
  "lint-staged": {
    "*.{vue,ts,tsx,js}": "eslint --cache --fix",
    "*.{vue,scss,css}": "stylelint --cache --fix",
    "*.{json,md}": "prettier --cache --write"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@plasmohq/messaging": "^0.7.2",
    "@plasmohq/storage": "^1.15.0",
    "@vueuse/core": "^14.3.0",
    "copy-to-clipboard": "^4.0.2",
    "js-tiktoken": "^1.0.21",
    "jsonfile": "^6.2.1",
    "pangu": "^7.2.1",
    "pinia": "^3.0.4",
    "vue": "3.5.35",
    "vue-toast-notification": "^3.1.3",
    "vue3-markdown-it": "^1.0.10",
    "vue3-popper": "^1.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@parcel/optimizer-data-url": "2.9.3",
    "@parcel/transformer-inline-string": "2.9.3",
    "@types/chrome": "0.1.42",
    "@types/node": "25.9.1",
    "eslint": "^10.4.0",
    "eslint-config-standard-one": "^0.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "plasmo": "0.90.5",
    "prettier": "3.8.3",
    "prettier-config-standard-one": "^0.0.1",
    "stylelint": "^17.12.0",
    "stylelint-config-standard-one": "^0.0.1",
    "typescript": "6.0.3",
    "vue3-gettext": "4.0.0-beta.1"
  },
  "manifest": {
    "default_locale": "en",
    "host_permissions": [
      "<all_urls>"
    ],
    "permissions": [
      "tabs",
      "storage",
      "clipboardWrite"
    ],
    "web_accessible_resources": [
      {
        "matches": [
          "<all_urls>"
        ],
        "resources": [
          "manifest.json",
          "*.css"
        ]
      }
    ]
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@^1.0.0": "1.1.18",
      "brace-expansion@^5.0.0": "5.0.9",
      "braces": "3.0.3",
      "content-security-policy-parser": "0.6.0",
      "esbuild": "0.25.0",
      "fast-uri": "3.1.5",
      "flatted": "3.4.2",
      "immutable": "5.1.8",
      "js-yaml@^3.0.0": "3.15.1",
      "js-yaml@^4.0.0": "4.3.1",
      "linkify-it": "5.0.2",
      "markdown-it": "14.2.0",
      "micromatch": "4.0.8",
      "msgpackr": "1.11.12",
      "nanoid@^3.0.0": "3.3.18",
      "nanoid@^5.0.0": "5.1.16",
      "postcss": "8.5.23",
      "sharp": "0.35.0",
      "svelte": "5.55.7",
      "svgo@^2.0.0": "2.8.3",
      "trim": "0.0.3",
      "trim-newlines": "3.0.1",
      "yargs-parser": "13.1.2"
    }
  }
}
